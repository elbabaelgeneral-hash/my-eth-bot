# ============ قاعدة البيانات ============
def db(): return sqlite3.connect(DB_PATH)

def init_db():
    conn = db(); c = conn.cursor()
    c.execute("""CREATE TABLE IF NOT EXISTS users (
        user_id INTEGER PRIMARY KEY, first_name TEXT, username TEXT,
        max_bots INTEGER DEFAULT 2, max_sites INTEGER DEFAULT 1)""")
    c.execute("""CREATE TABLE IF NOT EXISTS channels (
        channel_id TEXT PRIMARY KEY, channel_name TEXT, invite_link TEXT)""")
    c.execute("""CREATE TABLE IF NOT EXISTS hosted_bots (
        bot_id INTEGER PRIMARY KEY AUTOINCREMENT, user_id INTEGER,
        name TEXT, file_path TEXT, status TEXT DEFAULT 'stopped', pid INTEGER)""")
    c.execute("""CREATE TABLE IF NOT EXISTS hosted_sites (
        site_id INTEGER PRIMARY KEY AUTOINCREMENT, user_id INTEGER,
        name TEXT, file_path TEXT, port INTEGER, url TEXT, status TEXT DEFAULT 'stopped', pid INTEGER)""")
    conn.commit(); conn.close()

def add_user(uid, fn, un):
    conn = db(); c = conn.cursor()
    c.execute("INSERT OR IGNORE INTO users (user_id, first_name, username, max_bots, max_sites) VALUES (?,?,?,?,?)", 
              (uid, fn, un or "", DEFAULT_MAX_BOTS, DEFAULT_MAX_SITES))
    conn.commit(); conn.close()

