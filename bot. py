async def check_sub_cb(update, ctx):
    q = update.callback_query; await q.answer()
    if await is_subscribed(q.from_user.id, ctx): await q.edit_message_text("✅ تم! ابعت /start.")
    else: await q.answer("❌ لم تشترك!", show_alert=True)

async def is_subscribed(uid, ctx):
    channels = get_channels()
    for cid, _, _ in channels:
        try:
            m = await ctx.bot.get_chat_member(cid, uid)
            if m.status in [ChatMember.LEFT, ChatMember.KICKED]: return False
        except: pass
    return True

