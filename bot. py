# ============ إدارة العمليات ============
def is_running(pid):
    if not pid: return False
    try: os.kill(pid, 0); return True
    except (ProcessLookupError, PermissionError): return False

def start_bot_process(bid):
    row = get_bot(bid)
    if not row: return False, "غير موجود"
    _, uid, name, file_path, _, old_pid = row
    if is_running(old_pid): return False, "يعمل بالفعل"
    fp = Path(file_path)
    if not fp.exists(): return False, "الملف غير موجود"
    
    try:
        log_path = fp.parent / "bot.log"
        with open(log_path, "w") as log:
            proc = subprocess.Popen([sys.executable, "-u", str(fp)], cwd=str(fp.parent),
                                    stdout=log, stderr=subprocess.STDOUT, start_new_session=True)
        update_bot_status(bid, "running", proc.pid)
        return True, "تم التشغيل"
    except Exception as e:
        return False, str(e)

def stop_bot_process(bid):
    row = get_bot(bid)
    if not row: return False, "غير موجود"
    _, _, _, _, _, pid = row
    if not pid: return False, "متوقف"
    try:
        os.killpg(os.getpgid(pid), signal.SIGTERM)
        update_bot_status(bid, "stopped", None)
        return True, "تم الإيقاف"
    except Exception:
        update_bot_status(bid, "stopped", None)
        return True, "تم الإيقاف"

def start_site_process(sid):
    row = get_site(sid)
    if not row: return False, "غير موجود"
    _, uid, name, file_path, port, old_url, status, old_pid = row
    if is_running(old_pid): return False, "يعمل بالفعل"
    
    fp = Path(file_path)
    index_file = fp / "index.html"
    if not index_file.exists(): return False, "ملف index.html غير موجود"
    
    try:
        http_log = open(fp.parent / "http.log", "w")
        http_proc = subprocess.Popen([sys.executable, "-m", "http.server", str(port)], cwd=str(fp),
                                     stdout=http_log, stderr=subprocess.STDOUT, start_new_session=True)
        
        cf_log = open(fp.parent / "cf.log", "w")
        cf_proc = subprocess.Popen(["cloudflared", "tunnel", "--url", f"http://localhost:{port}"],
                                   stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True, start_new_session=True)
        
        url = "جاري التجهيز..."
        time.sleep(4)
        for line in cf_proc.stdout:
            match = re.search(r'https://[a-zA-Z0-9-]+\.trycloudflare\.com', line)
            if match:
                url = match.group(0)
                break
                
        update_site_status(sid, "running", http_proc.pid, url)
        return True, url
    except Exception as e:
        return False, str(e)

def stop_site_process(sid):
    row = get_site(sid)
    if not row: return False, "غير موجود"
    _, _, _, _, _, _, _, pid = row
    if pid:
        try: os.killpg(os.getpgid(pid), signal.SIGTERM)
        except: pass
    try: subprocess.run(["pkill", "-f", f"http.server {row[4]}"], check=False)
    except: pass
    update_site_status(sid, "stopped", None, None)
    return True, "تم الإيقاف"

